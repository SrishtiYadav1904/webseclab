# =========================================================================
# WebSecLab Environment Configuration
# =========================================================================
# Note: WebSecLab includes an automatic zero-config Demo Mode.
# If these environment variables are left blank or omitted, the app will run
# fully functional with LocalStorage persistence and pre-populated demo state.

# Supabase Project URL (Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
